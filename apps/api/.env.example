# ============================================================
# API Server Environment
# ============================================================
# Copy to apps/api/.env and fill in real values.
# NEVER commit real secrets.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
ADMIN_API_KEY=your_secure_random_key_here

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_NAME=chatbot_platform
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me_in_production
DATABASE_SSL=false
DATABASE_LOGGING=true

# --- Redis (optional — only needed when REDIS_ENABLED=true) ---
REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Crawler ---
CRAWLER_ALLOW_TEST_LOOPBACK=false
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=3
CRAWLER_TIMEOUT_MS=10000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_RESPONSE_SIZE=5242880
CRAWLER_GLOBAL_CONCURRENCY=5
CRAWLER_PER_HOST_CONCURRENCY=2
CRAWLER_REQUEST_DELAY_MS=1000
CRAWLER_MAX_SITEMAP_SIZE=10485760
CRAWLER_MAX_SITEMAP_URLS=1000
